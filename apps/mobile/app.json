{
  "expo": {
    "name": "GEO EMPIRE",
    "slug": "geo-empire",
    "scheme": "geoempire",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0a0f16",
    "plugins": [
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GEO EMPIRE использует геолокацию для исследования территории и взаимодействия с игровым миром."
        }
      ]
    ],
    "android": {
      "package": "kz.geoempire.game",
      "versionCode": 4,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "ios": {
      "bundleIdentifier": "kz.geoempire.game",
      "supportsTablet": false
    }
  }
}
