# Server-side only. Never commit a real Neon connection string.
# In Render, add this as a secret environment variable named DATABASE_URL.
DATABASE_URL=

# API
HOST=0.0.0.0
PORT=4000
NODE_ENV=development

# Geospatial defaults
H3_RESOLUTION=12

# Mobile client. Use the backend address reachable from the emulator/device.
# Android emulator example: http://10.0.2.2:4000
# Physical device example: http://192.168.1.100:4000
# Production example after Render deployment: https://geo-empire-api.onrender.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Development-only player seeded into the Neon development branch.
EXPO_PUBLIC_DEMO_PLAYER_ID=11111111-1111-4111-8111-111111111111
